{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy-hub.invalid/protocol/v2/config.schema.json",
  "title": "config (client to server)",
  "type": "object",
  "required": ["type", "instances"],
  "properties": {
    "type": {"const": "config"},
    "currency": {"type": "string", "maxLength": 8},
    "instances": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/instance"}
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "required": ["id", "device", "name", "sensors"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"},
        "device": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "sensors": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {
            "description": "`source` is the id of the entity that feeds the slot, or the marker `static` for a static slot (a number, select or boolean selector), whose value is sent in `states`.",
            "type": "object",
            "required": ["source"],
            "properties": {"source": {"type": "string", "minLength": 1, "maxLength": 255}}
          }
        }
      }
    }
  }
}
