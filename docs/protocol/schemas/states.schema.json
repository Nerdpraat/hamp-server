{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy-hub.invalid/protocol/v2/states.schema.json",
  "title": "states (client to server)",
  "type": "object",
  "required": ["type", "items"],
  "properties": {
    "type": {"const": "states"},
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}\\.[a-z][a-z0-9_]*$"},
          "ts": {"type": "number"},
          "value": {
            "description": "A reading of an entity slot is a number. A static slot takes a number, string or boolean that fits its selector.",
            "type": ["number", "string", "boolean"]
          }
        }
      }
    }
  }
}
